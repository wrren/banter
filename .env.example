# Required. Generate one with `mix phx.gen.secret`.
SECRET_KEY_BASE=

# At least one LLM credential is required for chat to work.
# OpenRouter (default base URL):
LLM_API_KEY=
# or:
# OPENROUTER_API_KEY=

# Optional overrides:
# PHX_HOST=localhost
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=openai/gpt-4o-mini
# LLM_MODELS=openai/gpt-4o-mini,openai/gpt-4o
# BRAVE_SEARCH_API_KEY=
